# Maintainer: b3l0w <paquetes@b3l0w.local>
#
# El código se deja en ./src (lo hace el CI o a mano) y se compila acá.
# El binario va a /usr/bin: una sola ruta, un solo dueño.
pkgname=b3l0w-cli
pkgver=0.5.1
pkgrel=1
pkgdesc="CLI de administración de b3l0wz3r0-os"
arch=(x86_64)
url="https://github.com/Below-Z3R0/b3l0w-cli"
license=(MIT)
depends=(glibc)
makedepends=(go)
provides=(b3l0w)
conflicts=(b3l0w)
source=()
sha256sums=()

prepare() {
	# El código se copia desde el repo, no desde un snapshot en
	# files/: ese snapshot quedaba viejo en cada refactor y rompía el
	# build sin que nadie lo notara (el paquete se publicaba roto).
	#
	# El repo vive dos directorios arriba: packaging/b3l0w-cli -> repo.
	repo="$(cd "$startdir/../.." && pwd)"
	cp -r "$repo/cmd" "$srcdir"/
	cp -r "$repo/internal" "$srcdir"/
	cp "$repo/go.mod" "$repo/go.sum" "$srcdir"/
	cp "$repo/README.md" "$srcdir"/
}

build() {
	cd "$srcdir"
	CGO_ENABLED=0 go build -trimpath \
		-ldflags "-s -w -X github.com/Below-Z3R0/b3l0w-cli/internal/version.Version=v$pkgver" \
		-o b3l0w ./cmd/b3l0w
}

package() {
	install -Dm755 "$srcdir/b3l0w" "$pkgdir/usr/bin/b3l0w"
	install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"

	# El actualizador visible es b3l0w; por debajo sigue llamando a
	# arch-update (mantenimiento de CachyOS), que es una dependencia.
	install -Dm644 "$startdir/../assets/b3l0w-update.desktop" \
		"$pkgdir/usr/share/applications/b3l0w-update.desktop"
	for size in 16 24 32 48 64 128 256 512; do
		install -Dm644 "$startdir/../assets/icons/b3l0w-$size.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/b3l0w.png"
	done
}
