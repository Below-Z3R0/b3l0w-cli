# Maintainer: b3l0w <b3l0w@users.noreply.github.com>
# Vendored from AUR noctalia-git. No Quickshell: v5 is a C++ rewrite.
pkgname=noctalia-b3l0w
pkgver=5.2.1.r5789.gb409c9016
pkgrel=1
epoch=1
pkgdesc='A sleek, customizable desktop shell crafted for Wayland (b3l0w build)'
arch=('x86_64' 'aarch64')
url='https://github.com/noctalia-dev/noctalia'
license=('MIT')
options=('!debug')
depends=(
  'cairo'
  'curl'
  'fontconfig'
  'freetype2'
  'gcc-libs'
  'git'
  'glib2'
  'glibc'
  'jemalloc'
  'libglvnd'
  'libical'
  'libjxl'
  'libpipewire'
  'libqalculate'
  'librsvg'
  'libsecret'
  'libsndfile'
  'libsodium'
  'libwebp'
  'libwireplumber'
  'libxkbcommon'
  'libxml2'
  'md4c'
  'pam'
  'polkit'
  'pango'
  'sdbus-cpp'
  'tomlplusplus'
  'wayland'
)
makedepends=(
  'meson'
  'ninja'
  'nlohmann-json'
  'pkgconf'
  'stb'
  'wayland-protocols'
)
provides=('noctalia')
conflicts=('noctalia' 'noctalia-bin' 'noctalia-git')
source=('noctalia::git+https://github.com/noctalia-dev/noctalia.git#branch=main')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/noctalia"
  local version
  version=$(tr -d '[:space:]' < VERSION)
  printf '%s.r%s.g%s' "${version:-0.0.0}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=9 HEAD)"
}

build() {
  CXXFLAGS+=" -Wno-unused-result"
  arch-meson "$srcdir/noctalia" "$srcdir/build-release" \
    -Db_ndebug=true \
    -Dtests=disabled
  meson compile -C "$srcdir/build-release"
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build-release" --no-rebuild
  install -Dm644 "$srcdir/noctalia/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/noctalia/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
